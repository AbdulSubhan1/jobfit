# Copy to .env.local and fill in. Never commit real values.

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth app (github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# AI provider: google | groq | openai | anthropic | ollama
AI_PROVIDER=google
AI_MODEL=gemini-flash-lite-latest
# Set only the key for the provider you use
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api

# AI runs per signed-in user per day (UTC)
AI_DAILY_LIMIT=5

# Upstash Redis (console.upstash.com). The Vercel integration sets KV_REST_API_URL/KV_REST_API_TOKEN instead;
# either pair works. Without them, local dev uses an in-memory counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
